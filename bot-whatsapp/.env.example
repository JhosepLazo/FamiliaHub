# URL pública de la Edge Function bot-whatsapp.
# Para Supabase local: http://127.0.0.1:54321/functions/v1/bot-whatsapp
FAMILIAHUB_FUNCTION_URL=https://dqddeokbxzbmlbsltige.supabase.co/functions/v1/bot-whatsapp

# Mismo valor que el secreto FAMILIAHUB_BOT_SECRET configurado en Supabase.
# Generarlo con: openssl rand -hex 32
FAMILIAHUB_BOT_SECRET=

# Carpeta donde se guarda la sesión de WhatsApp. Nunca subirla al repositorio.
AUTH_DIR=auth

# fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=warn
